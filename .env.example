# Server Configuration
PORT=3000
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Model Configuration
# You can configure up to 20 models (MODEL_1 to MODEL_20)
# Only models with both value and title will be loaded
# Remove or comment out models you don't want to use
# Run 'ollama list' to see your installed models

# Model 1
MODEL_1=qwen2.5:3b
TITLE_1=Qwen 2.5 (3B)

# Model 2
MODEL_2=llama3.2:3b
TITLE_2=Llama 3.2 (3B)

# Model 3
MODEL_3=mistral:7b
TITLE_3=Mistral (7B)

# Model 4 (optional - uncomment to use)
#MODEL_4=phi3:mini
#TITLE_4=Phi-3 Mini

# Model 5 (optional - uncomment to use)
#MODEL_5=gemma2:2b
#TITLE_5=Gemma 2 (2B)

