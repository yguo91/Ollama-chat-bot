# Server Configuration
PORT=3000
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Model Configuration
# Auto-synced with your installed Ollama models
# You can configure up to 20 models (MODEL_1 to MODEL_20)
# Comment out models you don't want to use

# Model 1
MODEL_1=deepseek-r1:1.5b
TITLE_1=DeepSeek R1 (1.5B)

# Model 2
MODEL_2=qwen2.5:3b
TITLE_2=Qwen 2.5 (3B)

# Model 3
MODEL_3=qwen2.5:3b-instruct-q4_K_M
TITLE_3=Qwen 2.5 Instruct (3B)

# Model 4
MODEL_4=deepseek-ocr:3b
TITLE_4=DeepSeek OCR (3B)

# Model 5
MODEL_5=huihui_ai/qwen2.5-1m-abliterated:latest
TITLE_5=Qwen 2.5 1M Abliterated

# Model 6
